<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup=false stops cloud backup but not device-to-device transfer. Keep data on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
